  <step>
    <name>queryBridgeTable</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>LaMarcaTrasportiODS</connection>
    <sql>SELECT Rapportini.numeroTarga as gruppo, 
Rifornimenti.dataRifornimento as rifornimento, 
100 / COUNT(*) OVER (PARTITION BY Rapportini.numeroTarga) as peso 
FROM Rapportini 
JOIN Rifornimenti ON Rapportini.numeroTarga = Rifornimenti.numeroTarga
GROUP BY Rapportini.numeroTarga, Rifornimenti.dataRifornimento; </sql>
    <limit>0</limit>
    <lookup/>
