        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script qua

// Пример формата: "14/01/2015 18:26"
// Разбиваем строку по символам и конвертируем
function parseDate(dateString) {
    var parts = dateString.split(/[\-\s:]/); // Разделяем по "/", " " и ":"
    var year = parseInt(parts[0], 10);       // День
    var month = parseInt(parts[1], 10) - 1; // Месяц (в JS месяц с 0)
    var day = parseInt(parts[2], 10);      // Год
    var hours = parseInt(parts[3], 10);     // Часы
    var minutes = parseInt(parts[4], 10);   // Минуты

    return new Date(year, month, day, hours, minutes);
}
// Применяем функцию к каждому полю
var dateOraPartenza = parseDate(dataOraPartenza);
var dateOraArrivo = parseDate(dataOraArrivo);
var dataCompilazione = parseDate(dataCompilazione);</jsScript_script>
      </jsScript>
